# yamllint config for the hand-written YAML specs under docs/to-be-validated/
# (indented sequences). The source manifests are no longer a committed tree:
# the tests validate what byakugan.sources_model builds against
# byakugan/car_source_schema.yaml (yamale), so nothing else is linted here.
extends: default
rules:
  line-length: disable
  document-start: disable
  comments: disable
  comments-indentation: disable
  truthy: disable
  empty-lines:
    max: 2
  indentation:
    spaces: 2
    indent-sequences: consistent
