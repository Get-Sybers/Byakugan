{
  "_meta": {
    "contract": "car-ecs-projection",
    "generated_by": "python elastic/projection/render_elastic.py",
    "recompute_on": "any projection change (conventions.yml, objects/*.yml, ecs_types.yml, relationships.yml, inferred.yml)",
    "source": [
      "elastic/projection/conventions.yml",
      "elastic/projection/objects/module.yml",
      "elastic/projection/ecs_types.yml"
    ],
    "version": 3
  },
  "template": {
    "mappings": {
      "properties": {
        "car": {
          "properties": {
            "module": {
              "properties": {
                "base_address": {
                  "type": "keyword"
                },
                "fqdn": {
                  "path": "host.hostname",
                  "type": "alias"
                },
                "hostname": {
                  "path": "host.hostname",
                  "type": "alias"
                },
                "image_path": {
                  "path": "process.executable",
                  "type": "alias"
                },
                "md5_hash": {
                  "path": "dll.hash.md5",
                  "type": "alias"
                },
                "module_name": {
                  "path": "dll.name",
                  "type": "alias"
                },
                "module_path": {
                  "path": "dll.path",
                  "type": "alias"
                },
                "pid": {
                  "path": "process.pid",
                  "type": "alias"
                },
                "sha1_hash": {
                  "path": "dll.hash.sha1",
                  "type": "alias"
                },
                "sha256_hash": {
                  "path": "dll.hash.sha256",
                  "type": "alias"
                },
                "signature_valid": {
                  "path": "dll.code_signature.valid",
                  "type": "alias"
                },
                "signer": {
                  "path": "dll.code_signature.subject_name",
                  "type": "alias"
                },
                "tid": {
                  "path": "process.thread.id",
                  "type": "alias"
                }
              }
            }
          }
        },
        "dll": {
          "properties": {
            "code_signature": {
              "properties": {
                "subject_name": {
                  "type": "keyword"
                },
                "valid": {
                  "type": "boolean"
                }
              }
            },
            "hash": {
              "properties": {
                "md5": {
                  "type": "keyword"
                },
                "sha1": {
                  "type": "keyword"
                },
                "sha256": {
                  "type": "keyword"
                }
              }
            },
            "name": {
              "type": "keyword"
            },
            "path": {
              "type": "keyword"
            }
          }
        },
        "file": {
          "properties": {
            "code_signature": {
              "properties": {
                "subject_name": {
                  "type": "keyword"
                },
                "valid": {
                  "type": "boolean"
                }
              }
            },
            "hash": {
              "properties": {
                "md5": {
                  "type": "keyword"
                },
                "sha1": {
                  "type": "keyword"
                },
                "sha256": {
                  "type": "keyword"
                }
              }
            },
            "name": {
              "type": "keyword"
            },
            "path": {
              "type": "keyword"
            }
          }
        },
        "host": {
          "properties": {
            "hostname": {
              "type": "keyword"
            }
          }
        },
        "process": {
          "properties": {
            "executable": {
              "type": "keyword"
            },
            "pid": {
              "type": "long"
            },
            "thread": {
              "properties": {
                "id": {
                  "type": "long"
                }
              }
            }
          }
        },
        "related": {
          "properties": {
            "hash": {
              "type": "keyword"
            },
            "hosts": {
              "type": "keyword"
            }
          }
        }
      }
    }
  }
}
