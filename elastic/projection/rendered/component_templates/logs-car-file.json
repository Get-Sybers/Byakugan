                },
                "content": {
                  "type": "text"
                },
                "creation_time": {
                  "path": "file.created",
                  "type": "alias"
                },
                "extension": {
                  "path": "file.extension",
                  "type": "alias"
                },
                "file_name": {
                  "path": "file.name",
                  "type": "alias"
                },
                "file_path": {
                  "path": "file.path",
                  "type": "alias"
                },
                "fqdn": {
                  "path": "host.hostname",
                  "type": "alias"
                },
                "gid": {
                  "path": "file.gid",
                  "type": "alias"
                },
                "group": {
                  "path": "file.group",
                  "type": "alias"
                },
                "hostname": {
                  "path": "host.hostname",
                  "type": "alias"
                },
                "image_path": {
                  "path": "process.executable",
                  "type": "alias"
                },
                "link_target": {
                  "path": "file.target_path",
                  "type": "alias"
                },
                "md5_hash": {
                  "path": "file.hash.md5",
                  "type": "alias"
                },
                "mime_type": {
                  "path": "file.mime_type",
                  "type": "alias"
                },
                "mode": {
                  "path": "file.mode",
                  "type": "alias"
                },
                "owner": {
                  "path": "file.owner",
                  "type": "alias"
                },
                "owner_uid": {
                  "path": "file.uid",
                  "type": "alias"
                },
                "pid": {
