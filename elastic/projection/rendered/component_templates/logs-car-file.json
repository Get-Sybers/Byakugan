                },
                "sha256": {
                  "type": "keyword"
                }
              }
            },
            "mime_type": {
              "type": "keyword"
            },
            "mode": {
              "type": "keyword"
            },
            "name": {
              "type": "keyword"
            },
            "owner": {
              "type": "keyword"
            },
            "path": {
              "type": "keyword"
            },
            "pe": {
              "properties": {
                "company": {
                  "type": "keyword"
                }
              }
            },
            "target_path": {
              "type": "keyword"
            },
            "uid": {
              "type": "keyword"
            }
          }
        },
        "host": {
          "properties": {
