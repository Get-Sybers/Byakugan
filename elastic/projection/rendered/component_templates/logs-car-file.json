                  "type": "alias"
                },
                "ppid": {
                  "path": "process.parent.pid",
                  "type": "alias"
                },
                "previous_creation_time": {
                  "type": "date"
                },
                "sha1_hash": {
                  "path": "file.hash.sha1",
                  "type": "alias"
                },
                "sha256_hash": {
                  "path": "file.hash.sha256",
                  "type": "alias"
                },
                "signature_valid": {
                  "path": "file.code_signature.valid",
                  "type": "alias"
                },
                "signer": {
                  "path": "file.code_signature.subject_name",
                  "type": "alias"
                },
                "uid": {
                  "path": "user.id",
                  "type": "alias"
                },
                "user": {
                  "path": "user.name",
                  "type": "alias"
                }
              }
            }
          }
        },
        "file": {
          "properties": {
            "code_signature": {
              "properties": {
                "subject_name": {
                  "type": "keyword"
                },
                "valid": {
                  "type": "boolean"
                }
              }
            },
            "created": {
              "type": "date"
            },
            "extension": {
              "type": "keyword"
            },
            "gid": {
              "type": "keyword"
            },
            "group": {
              "type": "keyword"
            },
            "hash": {
              "properties": {
                "md5": {
                  "type": "keyword"
                },
                "sha1": {
