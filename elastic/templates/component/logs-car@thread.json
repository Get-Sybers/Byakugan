{
  "_meta": {
    "contract": "car-ecs-projection",
    "generated_by": "python model/projection/render_elastic.py",
    "recompute_on": "any projection change (conventions.yml, objects/*.yml, ecs_types.yml, relationships.yml, inferred.yml)",
    "source": [
      "model/projection/conventions.yml",
      "model/projection/objects/thread.yml",
      "model/projection/ecs_types.yml"
    ],
    "version": 3
  },
  "template": {
    "mappings": {
      "properties": {
        "car": {
          "properties": {
            "thread": {
              "properties": {
                "hostname": {
                  "path": "host.hostname",
                  "type": "alias"
                },
                "src_pid": {
                  "path": "process.pid",
                  "type": "alias"
                },
                "src_tid": {
                  "path": "process.thread.id",
                  "type": "alias"
                },
                "stack_base": {
                  "type": "keyword"
                },
                "stack_limit": {
                  "type": "keyword"
                },
                "start_address": {
                  "type": "keyword"
                },
                "start_function": {
                  "type": "keyword"
                },
                "start_module": {
                  "path": "dll.path",
                  "type": "alias"
                },
                "start_module_name": {
                  "path": "dll.name",
                  "type": "alias"
                },
                "tgt_pid": {
                  "type": "long"
                },
                "tgt_tid": {
                  "type": "long"
                },
                "uid": {
                  "path": "user.id",
                  "type": "alias"
                },
                "user": {
                  "path": "user.name",
                  "type": "alias"
                },
                "user_stack_base": {
                  "type": "keyword"
                },
                "user_stack_limit": {
                  "type": "keyword"
                }
              }
            }
          }
        },
        "dll": {
          "properties": {
            "name": {
              "type": "keyword"
            },
            "path": {
              "type": "keyword"
            }
          }
        },
        "host": {
          "properties": {
            "hostname": {
              "type": "keyword"
            }
          }
        },
        "process": {
          "properties": {
            "pid": {
              "type": "long"
            },
            "thread": {
              "properties": {
                "id": {
                  "type": "long"
                }
              }
            }
          }
        },
        "related": {
          "properties": {
            "hosts": {
              "type": "keyword"
            },
            "user": {
              "type": "keyword"
            }
          }
        },
        "user": {
          "properties": {
            "id": {
              "type": "keyword"
            },
            "name": {
              "type": "keyword"
            }
          }
        }
      }
    }
  }
}
