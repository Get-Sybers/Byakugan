{
  "_meta": {
    "contract": "car-ecs-projection",
    "generated_by": "python model/projection/render_elastic.py",
    "recompute_on": "any projection change (conventions.yml, objects/*.yml, ecs_types.yml, relationships.yml, inferred.yml)",
    "source": [
      "model/projection/conventions.yml",
      "model/projection/objects/service.yml",
      "model/projection/ecs_types.yml"
    ],
    "version": 3
  },
  "template": {
    "mappings": {
      "properties": {
        "car": {
          "properties": {
            "service": {
              "properties": {
                "command_line": {
                  "path": "process.command_line",
                  "type": "alias"
                },
                "exe": {
                  "path": "process.name",
                  "type": "alias"
                },
                "fqdn": {
                  "path": "host.hostname",
                  "type": "alias"
                },
                "hostname": {
                  "path": "host.hostname",
                  "type": "alias"
                },
                "image_path": {
                  "path": "process.executable",
                  "type": "alias"
                },
                "name": {
                  "path": "service.name",
                  "type": "alias"
                },
                "pid": {
                  "path": "process.pid",
                  "type": "alias"
                },
                "ppid": {
                  "path": "process.parent.pid",
                  "type": "alias"
                },
                "uid": {
                  "path": "user.id",
                  "type": "alias"
                },
                "user": {
                  "path": "user.name",
                  "type": "alias"
                }
              }
            }
          }
        },
        "host": {
          "properties": {
            "hostname": {
              "type": "keyword"
            }
          }
        },
        "process": {
          "properties": {
            "command_line": {
              "type": "keyword"
            },
            "executable": {
              "type": "keyword"
            },
            "name": {
              "type": "keyword"
            },
            "parent": {
              "properties": {
                "pid": {
                  "type": "long"
                }
              }
            },
            "pid": {
              "type": "long"
            }
          }
        },
        "related": {
          "properties": {
            "hosts": {
              "type": "keyword"
            },
            "user": {
              "type": "keyword"
            }
          }
        },
        "service": {
          "properties": {
            "name": {
              "type": "keyword"
            }
          }
        },
        "user": {
          "properties": {
            "id": {
              "type": "keyword"
            },
            "name": {
              "type": "keyword"
            }
          }
        }
      }
    }
  }
}
