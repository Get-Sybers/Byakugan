# Byakugan standalone Elastic stack — copy to .env next to docker-compose.yml
# and replace every placeholder. .env is gitignored: NEVER commit real secrets.
#   passwords: >= 6 chars (no quotes/backslashes)

# Elastic stack version (Elasticsearch + Kibana). Same default pin as
# DX_DFIR's own stack (../../DX_DFIR/docker/elastic/.env.example).
ELASTIC_VERSION=9.4.3

# `elastic` superuser — bootstrap password for Elasticsearch.
ELASTIC_PASSWORD=change-me-elastic

# `kibana_system` — set by config/setup.sh, used by Kibana to reach
# Elasticsearch.
KIBANA_SYSTEM_PASSWORD=change-me-kibana

# `byakugan_loader` — created by config/setup.sh with the least-privilege
# logs_car_writer role (create_doc/create_index/read/view_index_metadata on
# logs-car.* only, no cluster privileges). Used for every ROUTINE
# (non --setup) `byakugan.elastic.load` push; the first load (--setup, which
# also needs to manage index/component templates and import the Kibana
# bundle) authenticates as elastic instead — see elastic/README.md.
BYAKUGAN_LOADER_PASSWORD=change-me-byakugan-loader

# Elasticsearch JVM heap (keep at/under ~50% of the elasticsearch service's
# mem_limit in docker-compose.yml).
ES_JAVA_OPTS=-Xms1g -Xmx1g

# Optional: override the published loopback ports if 9201/5602 collide with
# something else already running on this host.
#BYAKUGAN_STANDALONE_ES_PORT=9201
#BYAKUGAN_STANDALONE_KIBANA_PORT=5602
