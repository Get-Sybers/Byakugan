{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/Get-Sybers/Byakugan/-/raw/main/model/schema/wire/bundle.schema.json",
 "title": "Wire bundle — GENERATED envelope",
 "description": "Never hand-edited: python -m byakugan.schema_gen regenerates it (conform class-regen gates drift).",
 "type": "object",
 "required": [
  "type",
  "id",
  "objects"
 ],
 "properties": {
  "type": {
   "const": "bundle"
  },
  "id": {
   "allOf": [
    {
     "$ref": "../vendor/oasis/common/identifier.json"
    },
    {
     "pattern": "^bundle--"
    }
   ]
  },
  "objects": {
   "type": "array",
   "minItems": 1,
   "items": {
    "$ref": "objects.schema.json"
   }
  }
 },
 "unevaluatedProperties": false
}
