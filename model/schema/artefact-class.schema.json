{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/Get-Sybers/Byakugan/-/raw/main/model/schema/artefact-class.schema.json",
 "title": "Artefact Class — what the evidence is (parser-independent)",
 "description": "One declaration per family (docs/design/schema-layers.md). Instances are GENERATED by byakugan.schema_gen from the curated seed, the ir.json closure and the matched overlay; the evidences constraints block in the overlay is the normative layer.",
 "type": "object",
 "allOf": [
  {
   "$ref": "envelope.schema.json"
  }
 ],
 "properties": {
  "schema_version": true,
  "generated_from": true,
  "source": true,
  "family": {
   "type": "string",
   "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
  },
  "platform": {
   "type": "array",
   "items": {
    "enum": [
     "windows",
     "linux",
     "macos"
    ]
   },
   "uniqueItems": true,
   "description": "closed generated enum; [] = platform-agnostic; extension is envelope-versioned (admission rule)"
  },
  "domain": {
   "enum": [
    "filesystem",
    "memory",
    "network",
    "cloud"
   ]
  },
  "object": {
   "type": [
    "string",
    "null"
   ],
   "description": "the STIX SCO the primary entity grounds to; null for event-log families whose rows carry per-record objects"
  },
  "dfir_fields": {
   "type": "object",
   "description": "the guaranteed field-level yields (phase 6 mines them from the parser record structs)"
  },
  "references": {
   "type": "array",
   "items": {
    "$ref": "defs.schema.json#/$defs/external-reference"
   }
  },
  "aliases": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "uniqueItems": true
  },
  "evidences": {
   "type": "array",
   "items": {
    "type": "object",
    "allOf": [
     {
      "$ref": "vocab/car-actions.schema.json#/$defs/pair"
     }
    ],
    "properties": {
     "object": true,
     "action": {
      "type": "string"
     },
     "evidence": {
      "$ref": "defs.schema.json#/$defs/evidence-tier"
     },
     "time": {
      "$ref": "defs.schema.json#/$defs/time-semantics"
     },
     "when": {
      "type": "string"
     },
     "basis": {
      "type": "string"
     },
     "note": {
      "type": "string"
     },
     "sources": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "minItems": 1
     }
    },
    "required": [
     "object",
     "action",
     "evidence",
     "time",
     "sources"
    ],
    "unevaluatedProperties": false
   }
  }
 },
 "required": [
  "family",
  "platform",
  "domain",
  "references",
  "aliases",
  "evidences"
 ],
 "unevaluatedProperties": false
}
