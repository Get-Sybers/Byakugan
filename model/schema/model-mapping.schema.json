{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/Get-Sybers/Byakugan/-/raw/main/model/schema/model-mapping.schema.json",
 "title": "Model Mapping — the hourglass waist as declarations",
 "description": "One declaration per ir lane (docs/design/schema-layers.md): input is the Artefact Class the lane feeds, output the (object, action) pairs, identity the spindle recipe, predicates BY NAME ONLY — implementations live in the code registries (go/internal/predicates; the Python engine registry at phase 7) and conform rule mapping-coverage holds declared == registered against ir.json both ways. Instances are GENERATED from go/internal/ir/ir.json by byakugan.schema_gen; gen-ir keeps ir.json byte-exact against the Go authoring tables. mappings/routes.yaml carries the routing table ($defs/routing).",
 "$defs": {
  "action": {
   "oneOf": [
    {"type": "string", "minLength": 1},
    {
     "type": "object",
     "properties": {
      "declared": {"type": "array", "items": {"type": "string"}},
      "open": {"type": "boolean"}
     },
     "required": ["declared", "open"],
     "unevaluatedProperties": false
    }
   ]
  },
  "leaf": {
   "type": "object",
   "properties": {
    "when": {"type": "string", "minLength": 1},
    "object": {"type": ["string", "null"]},
    "action": {"$ref": "#/$defs/action"},
    "identity": {"type": ["string", "null"]},
    "artefact_class": {"type": "string", "minLength": 1},
    "fields": {"type": "array", "items": {"type": "string"}}
   },
   "required": ["object", "action", "identity", "fields"],
   "unevaluatedProperties": false
  },
  "mapping": {
   "type": "object",
   "allOf": [{"$ref": "envelope.schema.json"}],
   "properties": {
    "schema_version": true,
    "generated_from": true,
    "source": {"const": "generated"},
    "lane": {"type": "string", "minLength": 1},
    "artefact_class": {"type": ["string", "null"]},
    "variants": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/leaf"}},
    "default": {"oneOf": [{"$ref": "#/$defs/leaf"}, {"type": "null"}]}
   },
   "required": ["lane", "artefact_class", "variants", "default"],
   "unevaluatedProperties": false
  },
  "routing": {
   "type": "object",
   "allOf": [{"$ref": "envelope.schema.json"}],
   "properties": {
    "schema_version": true,
    "generated_from": true,
    "source": {"const": "generated"},
    "routes": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "description": "lanes: [] is a DECLARED state — the source is recognised and deliberately unmapped (recognise-and-skip), never an unknown file.",
      "properties": {
       "match": {"type": "string", "minLength": 1},
       "lanes": {"type": "array", "items": {"type": "string"}}
      },
      "required": ["match", "lanes"],
      "unevaluatedProperties": false
     }
    },
    "evtx_maps": {"type": "array", "items": {"type": "string"}},
    "adapters": {
     "type": "object",
     "additionalProperties": {
      "type": "object",
      "properties": {
       "adapter": {"type": "string", "minLength": 1},
       "maps": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      },
      "required": ["adapter", "maps"],
      "unevaluatedProperties": false
     }
    }
   },
   "required": ["routes", "evtx_maps", "adapters"],
   "unevaluatedProperties": false
  }
 }
}
