{
  "_meta": {
    "contract": "car-ecs-projection",
    "generated_by": "python model/projection/render_elastic.py",
    "recompute_on": "any projection change (conventions.yml, objects/*.yml, ecs_types.yml, relationships.yml, inferred.yml)",
    "source": [
      "model/projection/conventions.yml",
      "model/projection/objects/user_session.yml",
      "model/projection/ecs_types.yml"
    ],
    "version": 3
  },
  "template": {
    "mappings": {
      "properties": {
        "car": {
          "properties": {
            "user_session": {
              "properties": {
                "dest_ip": {
                  "path": "destination.ip",
                  "type": "alias"
                },
                "dest_port": {
                  "path": "destination.port",
                  "type": "alias"
                },
                "hostname": {
                  "path": "host.hostname",
                  "type": "alias"
                },
                "login_id": {
                  "type": "keyword"
                },
                "login_successful": {
                  "type": "keyword"
                },
                "login_type": {
                  "type": "keyword"
                },
                "src_ip": {
                  "path": "source.ip",
                  "type": "alias"
                },
                "src_port": {
                  "path": "source.port",
                  "type": "alias"
                },
                "uid": {
                  "path": "user.id",
                  "type": "alias"
                },
                "user": {
                  "path": "user.name",
                  "type": "alias"
                }
              }
            }
          }
        },
        "destination": {
          "properties": {
            "ip": {
              "type": "ip"
            },
            "port": {
              "type": "long"
            }
          }
        },
        "host": {
          "properties": {
            "hostname": {
              "type": "keyword"
            }
          }
        },
        "related": {
          "properties": {
            "hosts": {
              "type": "keyword"
            },
            "ip": {
              "type": "ip"
            },
            "user": {
              "type": "keyword"
            }
          }
        },
        "source": {
          "properties": {
            "ip": {
              "type": "ip"
            },
            "port": {
              "type": "long"
            }
          }
        },
        "user": {
          "properties": {
            "id": {
              "type": "keyword"
            },
            "name": {
              "type": "keyword"
            }
          }
        }
      }
    }
  }
}
